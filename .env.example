# Copy to .env and adjust. docker compose reads .env from this folder automatically.

# The user and group that own the media files (`id -u` and `id -g`).
PUID=1000
PGID=1000

# Depot's own data: database, keys and access token. Create it before the first start.
DEPOT_CONFIG_DIR=/path/to/depot/config

# The media folder that qBittorrent and Jellyfin also mount as /data, with downloads and
# libraries inside it (for example downloads/, movies/ and series/).
MEDIA_DIR=/path/to/media

# Port on the host for the web interface.
DEPOT_PORT=5080

# Every name used in the browser to reach Depot, separated by ";".
DEPOT_ALLOWED_HOSTS=localhost;127.0.0.1
